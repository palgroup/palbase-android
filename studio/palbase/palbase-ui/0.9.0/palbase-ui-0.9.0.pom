<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <!-- This module was also published with a richer model, Gradle metadata,  -->
  <!-- which should be used instead. Do not delete the following line which  -->
  <!-- is to indicate to Gradle or any Gradle module metadata file consumer  -->
  <!-- that they should prefer consuming it instead. -->
  <!-- do_not_remove: published-with-gradle-metadata -->
  <modelVersion>4.0.0</modelVersion>
  <groupId>studio.palbase</groupId>
  <artifactId>palbase-ui</artifactId>
  <version>0.9.0</version>
  <packaging>aar</packaging>
  <name>Palbase UI</name>
  <description>Palbase screens for Android: the paywalls, in-app messages and inbox cards a project designs, drawn natively in Jetpack Compose — the renderer the web's and iOS's are measured against with the same golden screens.</description>
  <url>https://palbase.studio</url>
  <licenses>
    <license>
      <name>Palbase SDK License</name>
      <url>https://github.com/palgroup/palbase-android/blob/main/LICENSE</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>palbase</id>
      <name>Palbase</name>
      <organization>Pallasite OÜ</organization>
      <organizationUrl>https://palbase.studio</organizationUrl>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/palgroup/palbase-android.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/palgroup/palbase-android.git</developerConnection>
    <url>https://github.com/palgroup/palbase-android</url>
  </scm>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>androidx.compose</groupId>
        <artifactId>compose-bom</artifactId>
        <version>2026.09.00</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <dependencies>
    <dependency>
      <groupId>studio.palbase</groupId>
      <artifactId>palbase</artifactId>
      <version>0.9.0</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>androidx.compose.ui</groupId>
      <artifactId>ui</artifactId>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>androidx.compose.foundation</groupId>
      <artifactId>foundation</artifactId>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-stdlib</artifactId>
      <version>2.3.20</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>androidx.compose.material3</groupId>
      <artifactId>material3</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.squareup.okhttp3</groupId>
      <artifactId>okhttp</artifactId>
      <version>5.5.0</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>
</project>
