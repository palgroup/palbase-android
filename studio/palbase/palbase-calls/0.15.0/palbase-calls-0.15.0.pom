<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <!-- This module was also published with a richer model, Gradle metadata,  -->
  <!-- which should be used instead. Do not delete the following line which  -->
  <!-- is to indicate to Gradle or any Gradle module metadata file consumer  -->
  <!-- that they should prefer consuming it instead. -->
  <!-- do_not_remove: published-with-gradle-metadata -->
  <modelVersion>4.0.0</modelVersion>
  <groupId>studio.palbase</groupId>
  <artifactId>palbase-calls</artifactId>
  <version>0.15.0</version>
  <packaging>aar</packaging>
  <name>Palbase Calls</name>
  <description>Palbase calls for Android: the signed-in person's voice and video calls — one to one or a group, through the platform's media server — rung by push with the app closed, in the system's call integration.</description>
  <url>https://palbase.studio</url>
  <licenses>
    <license>
      <name>Palbase SDK License</name>
      <url>https://github.com/palgroup/palbase-android/blob/main/LICENSE</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>palbase</id>
      <name>Palbase</name>
      <organization>Pallasite OÜ</organization>
      <organizationUrl>https://palbase.studio</organizationUrl>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/palgroup/palbase-android.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/palgroup/palbase-android.git</developerConnection>
    <url>https://github.com/palgroup/palbase-android</url>
  </scm>
  <dependencies>
    <dependency>
      <groupId>studio.palbase</groupId>
      <artifactId>palbase</artifactId>
      <version>0.15.0</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>studio.palbase</groupId>
      <artifactId>palbase-notify</artifactId>
      <version>0.15.0</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-stdlib</artifactId>
      <version>2.3.20</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>io.livekit</groupId>
      <artifactId>livekit-android</artifactId>
      <version>2.29.2</version>
      <scope>runtime</scope>
      <exclusions>
        <exclusion>
          <groupId>com.github.davidliu</groupId>
          <artifactId>audioswitch</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>androidx.core</groupId>
      <artifactId>core-telecom</artifactId>
      <version>1.0.1</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>androidx.core</groupId>
      <artifactId>core</artifactId>
      <version>1.16.0</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>
</project>
