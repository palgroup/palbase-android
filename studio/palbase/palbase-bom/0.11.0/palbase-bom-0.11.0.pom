  <!-- do_not_remove: published-with-gradle-metadata -->
  <modelVersion>4.0.0</modelVersion>
  <groupId>studio.palbase</groupId>
  <artifactId>palbase-bom</artifactId>
  <version>0.11.0</version>
  <packaging>pom</packaging>
  <name>Palbase BOM</name>
  <description>One version for every Palbase artifact an Android app takes.</description>
  <url>https://palbase.studio</url>
  <licenses>
