    </license>
  </licenses>
  <developers>
    <developer>
      <id>palbase</id>
      <name>Palbase</name>
      <organization>Pallasite OÜ</organization>
      <organizationUrl>https://palbase.studio</organizationUrl>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/palgroup/palbase-android.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/palgroup/palbase-android.git</developerConnection>
    <url>https://github.com/palgroup/palbase-android</url>
  </scm>
